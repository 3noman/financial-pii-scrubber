# Application Settings
APP_NAME="Financial Data Privacy Scrubber & AI Budget Analyzer"
APP_ENV=development
DEBUG=false
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# File Upload Security Limits
MAX_FILE_SIZE_MB=10
MAX_FILES_PER_REQUEST=10
TEMP_UPLOAD_DIR=./temp_uploads

# PostgreSQL Database (Matches docker-compose.yml)
POSTGRES_USER=scrubber_user
POSTGRES_PASSWORD=change_me_local_dev_password
POSTGRES_DB=financial_scrubber_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://scrubber_user:change_me_local_dev_password@localhost:5432/financial_scrubber_db

# Groq API Configuration
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_TIMEOUT_SECONDS=30